# cp .env.example .env и заполните значения
GRAFANA_ADMIN_PASSWORD=change-me

# Бот для алертов: создать у @BotFather, chat_id узнать у @userinfobot (для группы — отрицательное число)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Где слушают веб-интерфейсы. 127.0.0.1 — только локально (рекомендуется на сервере)
BIND_ADDRESS=127.0.0.1
